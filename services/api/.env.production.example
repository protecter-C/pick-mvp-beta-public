# Required production configuration. Copy to .env and inject real values via a secret manager.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
ENVIRONMENT=production
AUTH_SECRET=generate-a-long-random-secret
ADMIN_API_KEY=generate-a-separate-admin-secret
SERPAPI_KEY=serpapi-production-key

# Required by affiliate webhook verification in production.
AFFILIATE_WEBHOOK_SECRET=generate-a-separate-webhook-secret
